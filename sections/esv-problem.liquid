<section class="esv-problem" id="esv-problem-{{ section.id }}">

  <!-- ── Intro animation overlay (desktop only) ── -->
  <div class="esv-problem__intro-stage" aria-hidden="true">
    <div class="esv-problem__intro-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="esv-problem__intro-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="esv-problem__intro-heading">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="esv-problem__container">

    <div class="esv-problem__layout">

      <!-- Left: viewport with text layer + image+description layer stacked -->
      <div class="esv-problem__left">
        <div class="esv-problem__left-viewport">

          <!-- Text layer — normal flow, defines viewport height -->
          <div class="esv-problem__left-text esv-reveal">
            {%- if section.settings.eyebrow != blank -%}
              <p class="esv-problem__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            <h2 class="esv-problem__heading">{{ section.settings.heading }}</h2>
            {%- if section.settings.subheading != blank -%}
              <p class="esv-problem__subheading">{{ section.settings.subheading }}</p>
            {%- endif -%}
            {%- if section.settings.stat_number != blank -%}
              <div class="esv-problem__stat-block">
                <span class="esv-problem__stat-number">{{ section.settings.stat_number }}</span>
                <span class="esv-problem__stat-label">{{ section.settings.stat_label }}</span>
              </div>
            {%- endif -%}
          </div>

          <!-- Image + description layer — rolls up from below on click -->
          <div class="esv-problem__left-image">
            <div class="esv-problem__active-title-strip">
              <div class="esv-problem__active-icon-wrap"></div>
              <h3 class="esv-problem__active-title"></h3>
            </div>
            <img class="esv-problem__active-img" src="" alt="" aria-hidden="true">
            <p class="esv-problem__active-body"></p>
          </div>

        </div>
      </div>

      <!-- Right: symptom list, titles only (descriptions moved to left panel) -->
      <div class="esv-problem__right">

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-1"
             data-image="{{ section.settings.image_1 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_1_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="12" cy="12" rx="10" ry="6" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M12 5V3M12 21v-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_1_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_1 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="{{ section.settings.symptom_1_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_1_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_1_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-2"
             data-image="{{ section.settings.image_2 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_2_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="12" cy="12" rx="10" ry="6" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M7 19l1.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 20v-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M17 19l-1.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_2_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_2 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_2 | image_url: width: 800 }}" alt="{{ section.settings.symptom_2_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_2_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_2_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-3"
             data-image="{{ section.settings.image_3 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_3_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3C7 3 3 7.5 3 12s4 9 9 9 9-4 9-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M13 8l-2 4h3l-2 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_3_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_3 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_3 | image_url: width: 800 }}" alt="{{ section.settings.symptom_3_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_3_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_3_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-1"
             data-image="{{ section.settings.image_4 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_4_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="12" cy="12" rx="10" ry="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_4_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_4 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_4 | image_url: width: 800 }}" alt="{{ section.settings.symptom_4_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_4_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_4_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-2"
             data-image="{{ section.settings.image_5 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_5_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
                <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
                <path d="M12 3v2M12 19v2M3 12h2M19 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_5_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_5 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_5 | image_url: width: 800 }}" alt="{{ section.settings.symptom_5_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_5_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_5_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__symptom esv-reveal esv-reveal--delay-3"
             data-image="{{ section.settings.image_6 | image_url: width: 900 }}"
             data-body="{{ section.settings.symptom_6_body | escape }}">
          <button class="esv-problem__symptom-header" aria-expanded="false">
            <div class="esv-problem__symptom-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="12" cy="12" rx="10" ry="6" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M12 6V4" stroke="#FF2B5C" stroke-width="2" stroke-linecap="round"/>
                <circle cx="12" cy="3" r="0.75" fill="#FF2B5C"/>
              </svg>
            </div>
            <h3 class="esv-problem__symptom-title">{{ section.settings.symptom_6_title }}</h3>
            <span class="esv-problem__symptom-toggle" aria-hidden="true"></span>
          </button>
          <div class="esv-problem__mobile-detail">
            {%- if section.settings.image_6 != blank -%}
              <img class="esv-problem__mobile-img" src="{{ section.settings.image_6 | image_url: width: 800 }}" alt="{{ section.settings.symptom_6_title }}" loading="lazy">
            {%- endif -%}
            {%- if section.settings.symptom_6_body != blank -%}
              <p class="esv-problem__mobile-body">{{ section.settings.symptom_6_body }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="esv-problem__global-stat esv-reveal esv-reveal--delay-1">
          <div class="esv-problem__global-stat-header">
            <span class="esv-problem__global-stat-number">66%</span>
            <span class="esv-problem__global-stat-caption">of people who use digital screens daily report symptoms like these, worldwide</span>
          </div>
          <div class="esv-problem__global-stat-bar" role="img" aria-label="66 out of 100 people worldwide report digital eye strain symptoms">
            <div class="esv-problem__global-stat-bar-fill" style="width: 66% !important; background-color: #FF2B5C !important; display: block !important; height: 100% !important; min-height: 10px;"></div>
          </div>
          <p class="esv-problem__global-stat-source">
            Pooled prevalence across 45 studies, 17,526 participants —
            <a href="https://www.nature.com/articles/s41598-023-28750-6" target="_blank" rel="noopener noreferrer">Etsay Woldu Anbesu and Asamene Kelelom Lema</a>
            (2023), Scientific Reports
          </p>
        </div>

      </div>
    </div>


  </div>
</section>

<style>
  #esv-problem-{{ section.id }} {
    background: #f4f3f7;
    padding: 120px 40px;
  }

  #esv-problem-{{ section.id }} .esv-problem__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Two-column layout ── */
  #esv-problem-{{ section.id }} .esv-problem__layout {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Left column ── */
  #esv-problem-{{ section.id }} .esv-problem__left {
    position: sticky;
    top: 40px;
  }

  #esv-problem-{{ section.id }} .esv-problem__left-viewport {
    position: relative;
    overflow: hidden;
    transition: height 1.3s cubic-bezier(0.76, 0, 0.24, 1),
                background 0.55s ease,
                border-radius 0.55s ease,
                box-shadow 0.55s ease;
  }

  #esv-problem-{{ section.id }} .esv-problem__left-viewport.is-image-active {
    background: linear-gradient(160deg, rgba(255,255,255,0.74) 0%, rgba(238,236,248,0.54) 100%);
    backdrop-filter: blur(40px) saturate(1.25);
    -webkit-backdrop-filter: blur(40px) saturate(1.25);
    border-radius: 28px;
    box-shadow:
      0 28px 72px rgba(0,0,0,0.13),
      0 6px 20px rgba(0,0,0,0.07),
      inset 0 0 0 1px rgba(255,255,255,0.78),
      inset 0 2px 0 rgba(255,255,255,1);
  }

  /* Text layer — normal flow, defines container height */
  #esv-problem-{{ section.id }} .esv-problem__left-text {
    padding: 0 0 4px;
    transform: translateY(0);
    transition: transform 1.3s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }

  #esv-problem-{{ section.id }} .esv-problem__left-viewport.is-image-active .esv-problem__left-text {
    transform: translateY(-100%);
  }

  /* Image + description layer — no bottom constraint so image keeps full size */
  #esv-problem-{{ section.id }} .esv-problem__left-image {
    position: absolute;
    top: 0; left: 0; right: 0;
    transform: translateY(100%);
    transition: transform 1.3s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
    padding: 20px 20px 20px;
  }

  #esv-problem-{{ section.id }} .esv-problem__left-viewport.is-image-active .esv-problem__left-image {
    transform: translateY(0);
  }

  #esv-problem-{{ section.id }} .esv-problem__active-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 14px;
  }

  #esv-problem-{{ section.id }} .esv-problem__active-body {
    padding: 16px 0 0;
    font-size: calc(1.2rem * var(--esv-text-scale, 1));
    font-weight: 600;
    line-height: 1.6;
    color: #111111;
    background: transparent;
    margin: 0;
    border-top: 1px solid rgba(0,0,0,0.08);
    margin-top: 14px;
  }

  #esv-problem-{{ section.id }} .esv-problem__active-title-strip {
    padding: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #esv-problem-{{ section.id }} .esv-problem__active-icon-wrap {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: #FF2B5C;
  }

  #esv-problem-{{ section.id }} .esv-problem__active-icon-wrap svg {
    width: 100%;
    height: 100%;
  }

  #esv-problem-{{ section.id }} .esv-problem__active-title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #FF2B5C;
    margin: 0;
  }

  /* ── Left text content ── */
  #esv-problem-{{ section.id }} .esv-problem__eyebrow {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FF2B5C;
    margin: 0 0 20px;
  }

  #esv-problem-{{ section.id }} .esv-problem__heading {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #111111;
    margin: 0 0 24px;
  }

  #esv-problem-{{ section.id }} .esv-problem__subheading {
    font-size: calc(clamp(0.95rem, 1.4vw, 1.05rem) * var(--esv-text-scale, 1));
    line-height: 1.75;
    color: rgba(17,17,17, calc(0.55 + var(--esv-muted-boost, 0)));
    margin: 0 0 40px;
  }

  #esv-problem-{{ section.id }} .esv-problem__stat-block {
    border-top: 1px solid rgba(0,0,0,0.09);
    padding-top: 32px;
  }

  #esv-problem-{{ section.id }} .esv-problem__stat-number {
    display: block;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #FF2B5C;
    line-height: 1;
    margin-bottom: 14px;
  }

  #esv-problem-{{ section.id }} .esv-problem__stat-label {
    display: block;
    font-size: calc(0.9rem * var(--esv-text-scale, 1));
    line-height: 1.65;
    color: rgba(17,17,17, calc(0.55 + var(--esv-muted-boost, 0)));
  }

  /* ── Right column ── */
  #esv-problem-{{ section.id }} .esv-problem__right {
    display: flex;
    flex-direction: column;
  }

  /* ── Symptom row — border dividers ── */
  #esv-problem-{{ section.id }} .esv-problem__symptom {
    border-top: 1px solid rgba(0,0,0,0.09);
    transition: background 0.35s ease, border-radius 0.35s ease,
                box-shadow 0.35s ease, border-color 0.35s ease,
                margin 0.35s ease;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom:last-child {
    border-bottom: 1px solid rgba(0,0,0,0.09);
  }

  /* ── Global stat pictogram ── */
  #esv-problem-{{ section.id }} .esv-problem__global-stat {
    padding: 18px 4px 0;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-number {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #FF2B5C;
    line-height: 1;
    flex-shrink: 0;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-caption {
    font-size: calc(0.85rem * var(--esv-text-scale, 1));
    line-height: 1.4;
    color: rgba(17,17,17, calc(0.6 + var(--esv-muted-boost, 0)));
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-bar {
    width: 100%;
    height: 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.08);
    overflow: hidden;
    margin-bottom: 8px;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-bar-fill {
    width: 66%;
    height: 100%;
    border-radius: 999px;
    background: #FF2B5C;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-source {
    font-size: calc(0.72rem * var(--esv-text-scale, 1));
    color: rgba(17,17,17, calc(0.4 + var(--esv-muted-boost, 0)));
    margin: 0;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-source a {
    color: rgba(17,17,17, calc(0.55 + var(--esv-muted-boost, 0)));
    text-decoration: underline;
  }

  #esv-problem-{{ section.id }} .esv-problem__global-stat-source a:hover {
    color: #FF2B5C;
  }

  /* Desktop: open symptom collapses out of the list (height/opacity via JS) */
  @media (min-width: 1025px) {
    #esv-problem-{{ section.id }} .esv-problem__symptom.is-open {
      border-color: transparent;
      overflow: hidden;
    }
  }

  /* Mobile/tablet: open symptom shows as glass card */
  @media (max-width: 1024px) {
    #esv-problem-{{ section.id }} .esv-problem__symptom.is-open {
      background: rgba(255,255,255,0.62);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-color: transparent;
      border-radius: 18px;
      box-shadow: 0 4px 32px rgba(0,0,0,0.07), inset 0 0 0 1px rgba(255,255,255,0.85);
      margin: 6px 0;
    }
  }

  /* ── Symptom header button ── */
  #esv-problem-{{ section.id }} .esv-problem__symptom-header {
    width: 100%;
    display: grid;
    grid-template-columns: 22px 1fr 20px;
    column-gap: 20px;
    align-items: center;
    padding: 24px 20px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom-icon {
    width: 22px;
    height: 22px;
    color: rgba(17,17,17,0.35);
    flex-shrink: 0;
    transition: color 0.25s ease;
    align-self: start;
    margin-top: 4px;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-icon {
    color: #FF2B5C;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Title — grows 3x when open */
  #esv-problem-{{ section.id }} .esv-problem__symptom-title {
    font-size: calc(1.2rem * var(--esv-text-scale, 1));
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #111111;
    margin: 0;
    transition: font-size 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
                letter-spacing 0.45s ease,
                color 0.25s ease;
  }

  /* Toggle +/× */
  #esv-problem-{{ section.id }} .esv-problem__symptom-toggle {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: start;
    margin-top: 4px;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom-toggle::before,
  #esv-problem-{{ section.id }} .esv-problem__symptom-toggle::after {
    content: '';
    position: absolute;
    background: rgba(17,17,17,0.4);
    border-radius: 2px;
    transition: transform 0.3s ease, background 0.25s ease;
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom-toggle::before {
    width: 16px; height: 1.5px;
    top: 50%; left: 0;
    transform: translateY(-50%);
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom-toggle::after {
    width: 1.5px; height: 16px;
    left: 50%; top: 0;
    transform: translateX(-50%);
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-toggle::before,
  #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-toggle::after {
    background: #FF2B5C;
