  #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-toggle::before {
    transform: translateY(-50%) rotate(45deg);
  }

  #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-toggle::after {
    transform: translateX(-50%) rotate(45deg);
  }


  /* ── Scroll-reveal ── */
  #esv-problem-{{ section.id }} .esv-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #esv-problem-{{ section.id }} .esv-reveal--delay-1 { transition-delay: 0.05s; }
  #esv-problem-{{ section.id }} .esv-reveal--delay-2 { transition-delay: 0.12s; }
  #esv-problem-{{ section.id }} .esv-reveal--delay-3 { transition-delay: 0.19s; }
  #esv-problem-{{ section.id }} .esv-reveal.esv-visible {
    opacity: 1;
    transform: translateY(0);
