    #esv-problem-{{ section.id }} .esv-problem__stat-block {
      padding-top: 20px;
    }
    #esv-problem-{{ section.id }} .esv-problem__stat-number {
      font-size: clamp(2rem, 10vw, 3rem);
      margin-bottom: 8px;
    }
    #esv-problem-{{ section.id }} .esv-problem__stat-label {
      font-size: 0.82rem;
    }
    #esv-problem-{{ section.id }} .esv-problem__symptom-header {
      padding: 16px 14px;
    }
    #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-title {
      font-size: 1.4rem;
    }
    #esv-problem-{{ section.id }} .esv-problem__global-stat {
      padding-top: 16px;
    }
    #esv-problem-{{ section.id }} .esv-problem__global-stat-header {
      flex-direction: column;
      gap: 2px;
    }
    #esv-problem-{{ section.id }} .esv-problem__global-stat-number {
      font-size: 1.4rem;
    }
    #esv-problem-{{ section.id }} .esv-problem__global-stat-caption {
      font-size: 0.8rem;
    }
  }

  /* ── Intro animation (all screen sizes) ── */

  /* esv-reveal is bypassed — intro handles the entrance */
  #esv-problem-{{ section.id }} .esv-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    /* ── Intro stage (fixed overlay, covers full viewport) ── */
    #esv-problem-{{ section.id }} .esv-problem__intro-stage {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 17%;
      z-index: 10;
      pointer-events: none;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.7s ease, visibility 0s 0.7s;
    }

    #esv-problem-{{ section.id }} .esv-problem__intro-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    #esv-problem-{{ section.id }} .esv-problem__intro-eyebrow {
      font-size: clamp(3.5rem, 6.5vw, 7rem);
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #FF2B5C;
      text-align: center;
      margin: 0;
      opacity: 0;
      transform: translateY(28px);
      /* Appears first — no delay */
      transition: opacity 1.1s ease,
                  transform 1.1s cubic-bezier(0.34, 1.2, 0.64, 1);
    }

    #esv-problem-{{ section.id }} .esv-problem__intro-heading {
      font-size: clamp(0.875rem, 1.625vw, 1.75rem);
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.01em;
      color: #111111;
      text-align: center;
      margin: 0;
      opacity: 0;
      transform: translateY(20px);
      /* Appears only after eyebrow finishes (1.1s) + small pause (0.4s) */
      transition: opacity 1.1s ease 1.5s,
                  transform 1.1s cubic-bezier(0.34, 1.2, 0.64, 1) 1.5s;
    }

    /* State: pre-intro / showing — container hidden, intro stage invisible/visible */
    #esv-problem-{{ section.id }}.esv-problem--pre-intro .esv-problem__container,
    #esv-problem-{{ section.id }}.esv-problem--showing .esv-problem__container {
      opacity: 0;
      transform: translateY(16px);
    }

    /* State: showing — intro appears */
    #esv-problem-{{ section.id }}.esv-problem--showing .esv-problem__intro-stage {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.8s ease;
    }

    #esv-problem-{{ section.id }}.esv-problem--showing .esv-problem__intro-eyebrow {
      opacity: 1;
      transform: translateY(0);
    }

    #esv-problem-{{ section.id }}.esv-problem--showing .esv-problem__intro-heading {
      opacity: 1;
      transform: translateY(0);
    }

    /* State: settling — intro slides out left/down, container fades in */
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__intro-stage {
      visibility: visible;
      opacity: 0;
      transition: opacity 1.1s ease, visibility 0s 1.1s;
    }

    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__intro-center {
      opacity: 0;
      transform: translateX(-8vw) translateY(-8px);
      transition: opacity 1.0s ease, transform 1.0s ease;
    }

    /* Container stays hidden during settling so waterfall starts on a clean slate */
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__container {
      opacity: 0;
      transform: translateY(0);
    }

    /* Container snaps visible instantly — the waterfall elements create the visual entrance */
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__container {
      opacity: 1;
      transform: translateY(0);
      transition: none;
    }

    /* State: settled — stage removed */
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__intro-stage {
      display: none;
    }

    /* ── Waterfall cascade ── */

    /* All cascade elements start at translateY(-12px) during settling so they
       animate downward the moment the container snaps visible */
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__eyebrow,
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__heading,
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__subheading,
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__stat-block,
    #esv-problem-{{ section.id }}.esv-problem--settling .esv-problem__symptom {
      opacity: 0;
      transform: translateY(-12px);
    }

    /* All elements share the same fade+drop transition */
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__eyebrow,
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__heading,
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__subheading,
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__stat-block,
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.45s ease-out, transform 0.45s ease-out;
    }

    /* Left column — staggered by row (90 ms per step) */
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__eyebrow   { transition-delay:   0ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__heading    { transition-delay:  90ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__subheading { transition-delay: 180ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__stat-block { transition-delay: 270ms; }

    /* Right column — symptoms cascade at the same rhythm */
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(1) { transition-delay:   0ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(2) { transition-delay:  90ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(3) { transition-delay: 180ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(4) { transition-delay: 270ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(5) { transition-delay: 360ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(6) { transition-delay: 450ms; }

  /* ── Tablet & mobile: single-column layout — symptoms continue the waterfall after left content ── */
  @media (max-width: 1024px) {
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(1) { transition-delay: 360ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(2) { transition-delay: 450ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(3) { transition-delay: 540ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(4) { transition-delay: 630ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(5) { transition-delay: 720ms; }
    #esv-problem-{{ section.id }}.esv-problem--settled .esv-problem__symptom:nth-child(6) { transition-delay: 810ms; }
  }

  /* ── Mobile: scale down intro text to fit narrow viewport ── */
  @media (max-width: 749px) {
    #esv-problem-{{ section.id }} .esv-problem__intro-stage {
      padding: 0 6%;
    }
    #esv-problem-{{ section.id }} .esv-problem__intro-eyebrow {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }
    #esv-problem-{{ section.id }} .esv-problem__intro-heading {
      font-size: clamp(0.45rem, 2vw, 0.625rem);
    }
  }
</style>

<script>
(function() {
  var section         = document.getElementById('esv-problem-{{ section.id }}');
  var viewport        = section.querySelector('.esv-problem__left-viewport');
  var leftText        = section.querySelector('.esv-problem__left-text');
  var leftImage       = section.querySelector('.esv-problem__left-image');
  var activeImg       = section.querySelector('.esv-problem__active-img');
  var activeBody      = section.querySelector('.esv-problem__active-body');
  var activeTitle     = section.querySelector('.esv-problem__active-title');
  var activeIconWrap  = section.querySelector('.esv-problem__active-icon-wrap');
  var symptoms        = section.querySelectorAll('.esv-problem__symptom');
  var isDesktop       = function() { return window.innerWidth > 1024; };
  var heightResetTimer = null;
  var currentOpen     = null;
  var isSwitching     = false;
  var COLLAPSE_MS     = 430;
  var EXPAND_MS       = 430;
  var SWITCH_PAUSE    = 500;

  function applyImageHeight() {
    viewport.style.height = leftImage.scrollHeight + 'px';
  }

  function showImagePanel(imageUrl, bodyText, titleText) {
    clearTimeout(heightResetTimer);
    activeTitle.textContent = titleText || '';
    activeBody.textContent  = bodyText  || '';
    viewport.classList.add('is-image-active');
    activeImg.onload = applyImageHeight;
    activeImg.src    = imageUrl;
    if (activeImg.complete && activeImg.naturalHeight > 0) {
      applyImageHeight();
    }
  }

  function hideImagePanel() {
    viewport.style.height = leftText.scrollHeight + 'px';
    viewport.classList.remove('is-image-active');
    clearTimeout(heightResetTimer);
    heightResetTimer = setTimeout(function() {
      viewport.style.height = '';
    }, 1350);
  }

  /* Collapse a symptom row to height 0 */
  function collapseRow(el, cb) {
    el.style.height   = el.scrollHeight + 'px';
    el.style.overflow = 'hidden';
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        el.style.transition = 'height ' + (COLLAPSE_MS/1000) + 's cubic-bezier(0.76,0,0.24,1), opacity ' + (COLLAPSE_MS*0.7/1000) + 's ease';
        el.style.height     = '0';
        el.style.opacity    = '0';
      });
    });
    setTimeout(function() { if (cb) cb(); }, COLLAPSE_MS);
  }

  /* Expand a symptom row back to natural height */
  function expandRow(el, cb) {
    var target = el.scrollHeight;
    el.style.transition = 'height ' + (EXPAND_MS/1000) + 's cubic-bezier(0.76,0,0.24,1), opacity ' + (EXPAND_MS*0.8/1000) + 's ease 0.06s';
    el.style.height     = target + 'px';
    el.style.opacity    = '1';
    setTimeout(function() {
      el.style.height     = '';
      el.style.overflow   = '';
      el.style.transition = '';
      if (cb) cb();
    }, EXPAND_MS);
  }

  function openDesktop(sym) {
    var imageUrl  = sym.dataset.image;
    var bodyText  = sym.dataset.body;
    var titleText = sym.querySelector('.esv-problem__symptom-title').textContent.trim();
    var iconEl    = sym.querySelector('.esv-problem__symptom-icon');
    activeIconWrap.innerHTML = iconEl ? iconEl.innerHTML : '';
    sym.classList.add('is-open');
    sym.querySelector('.esv-problem__symptom-header').setAttribute('aria-expanded', 'true');
    collapseRow(sym, null);
    if (imageUrl) showImagePanel(imageUrl, bodyText, titleText);
  }

  function closeDesktop(sym, cb) {
    sym.classList.remove('is-open');
    sym.querySelector('.esv-problem__symptom-header').setAttribute('aria-expanded', 'false');
    hideImagePanel();
    setTimeout(function() { expandRow(sym, cb); }, 80);
  }

  symptoms.forEach(function(symptom) {
    var btn = symptom.querySelector('.esv-problem__symptom-header');

    btn.addEventListener('click', function() {

      /* ── Mobile behavior ── */
      if (!isDesktop()) {
        var wasOpen = symptom.classList.contains('is-open');
        symptoms.forEach(function(s) {
          s.classList.remove('is-open');
          s.querySelector('.esv-problem__symptom-header').setAttribute('aria-expanded', 'false');
        });
        if (!wasOpen) {
          symptom.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          section.classList.add('esv-problem--mobile-open');
          setTimeout(function() {
            symptom.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 50);
        } else {
          section.classList.remove('esv-problem--mobile-open');
        }
        return;
      }

      /* ── Desktop behavior ── */
      if (isSwitching) return;

      var isOpen = (symptom === currentOpen);

      if (isOpen) {
        /* Toggle closed */
        isSwitching = true;
        closeDesktop(symptom, function() {
          currentOpen = null;
          isSwitching = false;
        });

      } else if (currentOpen) {
        /* Switch: close previous → pause → open new */
        isSwitching = true;
        var prev = currentOpen;
        currentOpen = null;
        closeDesktop(prev, function() {
          setTimeout(function() {
            currentOpen = symptom;
            openDesktop(symptom);
            isSwitching = false;
          }, SWITCH_PAUSE);
        });

      } else {
        /* Open fresh */
        currentOpen = symptom;
        openDesktop(symptom);
      }
    });
  });

  /* ── Click anywhere on the glass box to close ── */
  viewport.addEventListener('click', function() {
    if (!isDesktop() || isSwitching || !currentOpen) return;
    isSwitching = true;
    var prev = currentOpen;
    currentOpen = null;
    closeDesktop(prev, function() {
      isSwitching = false;
    });
  });

  /* ── Entrance animation (all screen sizes) ── */
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    section.classList.add('esv-problem--pre-intro');

    var introObserver = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting) return;
      introObserver.disconnect();

      /* Phase 1: show intro */
      section.classList.remove('esv-problem--pre-intro');
      section.classList.add('esv-problem--showing');

      /* Phase 2: after 5200ms, settle (intro out, layout in) */
      setTimeout(function() {
        section.classList.remove('esv-problem--showing');
        section.classList.add('esv-problem--settling');

        /* Phase 3: after 1300ms, waterfall cascade */
        setTimeout(function() {
          section.classList.remove('esv-problem--settling');
          section.classList.add('esv-problem--settled');
        }, 1300);
      }, 5200);

    }, { threshold: 0.4 });

    introObserver.observe(section);
  }
})();
</script>

