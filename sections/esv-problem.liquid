  /* ── Mobile symptom detail view ── */
  #esv-problem-{{ section.id }} .esv-problem__mobile-detail {
    display: none;
  }

  @keyframes esv-detail-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    /* Hide non-open symptoms when one is active */
    #esv-problem-{{ section.id }}.esv-problem--mobile-open .esv-problem__symptom:not(.is-open) {
      display: none;
    }

    /* Hide the left-column text block when a symptom is open — full screen for detail */
    #esv-problem-{{ section.id }}.esv-problem--mobile-open .esv-problem__left {
      display: none;
    }

    /* Show and animate the detail panel */
    #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__mobile-detail {
      display: block;
      animation: esv-detail-in 0.4s ease forwards;
    }

    #esv-problem-{{ section.id }} .esv-problem__mobile-img {
      width: 100%;
      display: block;
      border-radius: 16px;
      margin-top: 20px;
      object-fit: cover;
    }

    #esv-problem-{{ section.id }} .esv-problem__mobile-body {
      margin: 16px 0 28px;
      font-size: calc(1rem * var(--esv-text-scale, 1));
      line-height: 1.7;
      color: rgba(17,17,17, calc(0.65 + var(--esv-muted-boost, 0)));
    }

    /* Keep the open symptom's title at a readable size on mobile */
    #esv-problem-{{ section.id }} .esv-problem__symptom.is-open .esv-problem__symptom-title {
      font-size: 1.6rem;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #esv-problem-{{ section.id }} {
      padding: 36px 16px 40px;
    }
    #esv-problem-{{ section.id }} .esv-problem__layout {
      gap: 20px;
    }
    #esv-problem-{{ section.id }} .esv-problem__eyebrow {
      font-size: clamp(1.5rem, 6vw, 2rem);
