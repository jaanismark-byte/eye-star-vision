<div class="esv-hero esv-hero--light" id="esv-hero-{{ section.id }}">

  <!-- NeatGradient canvas — always behind everything, never moves -->
  <canvas class="esv-hero__neat-canvas" id="esv-neat-canvas-{{ section.id }}"></canvas>

  <!-- Grain noise — above slider, pointer-events none -->
  <div class="esv-hero__noise"></div>

  <!-- Navigation — outside slider so position:fixed works from viewport -->
  <nav class="esv-nav esv-nav--intro-hidden" id="esv-nav-{{ section.id }}">
    <div class="esv-nav__inner">

      <a href="{{ routes.root_url }}" class="esv-nav__logo">
        <img
          src="{{ 'esv-icon.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="esv-nav__logo-img"
          width="44"
          height="44"
        >
      </a>

      <ul class="esv-nav__links">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="esv-nav__item">
            <a href="{{ link.url }}" class="esv-nav__link">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="esv-nav__actions">
        <a href="{{ routes.search_url }}" class="esv-nav__icon-link" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8.5" cy="8.5" r="6.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="{{ routes.cart_url }}" class="esv-nav__icon-link" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 2h2l2.4 9.6A2 2 0 008.3 13H16a2 2 0 001.9-1.4L19.5 6H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="9" cy="17" r="1" fill="currentColor"/>
            <circle cx="15" cy="17" r="1" fill="currentColor"/>
          </svg>
        </a>
        <button class="esv-nav__hamburger" id="esv-hamburger-{{ section.id }}" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>

    </div>
  </nav>

  <!-- Mobile full-screen menu -->
  <div class="esv-nav__mobile" id="esv-mobile-menu-{{ section.id }}" aria-hidden="true">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}" class="esv-nav__mobile-link">{{ link.title }}</a>
    {%- endfor -%}
    <div class="esv-nav__mobile-actions">
      <a href="{{ routes.search_url }}" class="esv-nav__icon-link" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8.5" cy="8.5" r="6.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="esv-nav__icon-link" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2h2l2.4 9.6A2 2 0 008.3 13H16a2 2 0 001.9-1.4L19.5 6H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="17" r="1" fill="currentColor"/>
          <circle cx="15" cy="17" r="1" fill="currentColor"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Intro overlay — plays once per page load, then removed -->
  <div class="esv-hero__intro" id="esv-intro-{{ section.id }}">
    <div class="esv-intro__content">
      <div class="esv-intro__stage">
        <img class="esv-intro__logo-text" src="{{ 'esv-logo-teksts.png' | asset_url }}" alt="{{ shop.name }}">
        <img class="esv-intro__logo-icon" src="{{ 'esv-logo-roza.png' | asset_url }}" alt="{{ shop.name }}">
        <svg class="esv-intro__circle-svg" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle
            class="esv-intro__circle"
            cx="150" cy="150" r="130"
            fill="none"
            stroke="#FF0000"
            stroke-width="1.5"
            stroke-linecap="round"
            transform="rotate(-90 150 150)"
            stroke-dasharray="817"
            stroke-dashoffset="817"
          />
        </svg>
      </div>
    </div>
  </div>

  <!-- Slider track: screen 1 (light) and screen 2 (dark), side by side -->
  <div class="esv-hero__slider" id="esv-slider-{{ section.id }}">

    <!-- Screen 1: light — s2_* settings, black product image -->
    <div class="esv-hero__slide esv-hero__slide--1">

      <!-- White cover — snaps opaque at forward-slide start so NeatGradient can switch to black -->
      <div class="esv-hero__slide1-bg" id="esv-slide1-bg-{{ section.id }}"></div>

      <div class="esv-hero__content esv-hero__content--light">

        {%- if section.settings.s2_eyebrow != blank -%}
          <p class="esv-hero__eyebrow">{{ section.settings.s2_eyebrow }}</p>
        {%- endif -%}

        <h1 class="esv-hero__heading">{{ section.settings.s2_heading }}</h1>

        <div class="esv-hero__product">
          <div class="esv-hero__product-wrap">
            <img
              src="{{ 'esv-product-hero-black.png' | asset_url }}"
              alt="Eye Star Vision device"
              class="esv-hero__product-img"
              width="900"
              loading="eager"
            >
          </div>
        </div>

        {%- if section.settings.s2_subheading != blank -%}
          <p class="esv-hero__subheading">{{ section.settings.s2_subheading }}</p>
        {%- endif -%}

        <div class="esv-hero__cta">
          {%- if section.settings.s2_button_label != blank -%}
            <a href="{{ section.settings.s2_button_link }}" class="esv-hero__button">
              {{ section.settings.s2_button_label }}
              <span class="esv-hero__button-arrow">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.s2_trust_text != blank -%}
            <p class="esv-hero__trust">{{ section.settings.s2_trust_text }}</p>
          {%- endif -%}
        </div>

      </div>
    </div>

    <!-- Screen 2: dark — original settings, white product image -->
    <div class="esv-hero__slide esv-hero__slide--2">

      <!-- Dark cover — snaps opaque at backward-slide start so NeatGradient can switch to white -->
      <div class="esv-hero__slide2-bg" id="esv-slide2-bg-{{ section.id }}"></div>

      <div class="esv-hero__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="esv-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="esv-hero__heading">{{ section.settings.heading }}</h1>

        <div class="esv-hero__product">
          <div class="esv-hero__product-wrap">
            <img
              src="{{ 'esv-product-balts-iepakojums.png' | asset_url }}"
              alt="Eye Star Vision device"
              class="esv-hero__product-img"
              width="900"
              loading="eager"
            >
          </div>
        </div>

        {%- if section.settings.subheading != blank -%}
          <p class="esv-hero__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="esv-hero__cta">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="esv-hero__button">
              {{ section.settings.button_label }}
              <span class="esv-hero__button-arrow">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.trust_text != blank -%}
            <p class="esv-hero__trust">{{ section.settings.trust_text }}</p>
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</div>

<style>
  /* ── Navigation — sticky, floating glass frame ── */
  #esv-hero-{{ section.id }} .esv-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 18px 20px 0;
    transition: opacity 0.5s ease, padding 0.35s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav--intro-hidden {
    opacity: 0;
    pointer-events: none;
  }

  #esv-hero-{{ section.id }} .esv-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    height: 68px;
    border-radius: 22px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
    box-shadow:
      0 14px 38px rgba(0,0,0,0.16),
      inset 0 0 0 1px rgba(255,255,255,0.18),
      inset 0 1px 0 rgba(255,255,255,0.28);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav.scrolled .esv-nav__inner {
    background: rgba(4, 0, 12, 0.6);
    box-shadow:
      0 14px 40px rgba(0,0,0,0.28),
      inset 0 0 0 1px rgba(255,255,255,0.10);
  }

  #esv-hero-{{ section.id }} .esv-nav__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  #esv-hero-{{ section.id }} .esv-nav__logo-img {
    height: 44px;
    width: 44px;
    display: block;
    border-radius: 10px;
    object-fit: contain;
  }

  #esv-hero-{{ section.id }} .esv-nav__links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #esv-hero-{{ section.id }} .esv-nav__link {
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.3s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav__link:hover {
    color: #ffffff;
  }

  #esv-hero-{{ section.id }} .esv-nav__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  #esv-hero-{{ section.id }} .esv-nav__icon-link {
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.3s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav__icon-link:hover {
    color: #ffffff;
  }

  /* ── Hamburger ── */
  #esv-hero-{{ section.id }} .esv-nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  #esv-hero-{{ section.id }} .esv-nav__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav__hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #esv-hero-{{ section.id }} .esv-nav__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  #esv-hero-{{ section.id }} .esv-nav__hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile drawer ── */
  #esv-hero-{{ section.id }} .esv-nav__mobile {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(4, 0, 12, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 1001;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #esv-hero-{{ section.id }} .esv-nav__mobile.open {
    opacity: 1;
  }

  #esv-hero-{{ section.id }} .esv-nav__mobile-link {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    padding: 18px 0;
    display: block;
    transition: color 0.2s;
  }

  #esv-hero-{{ section.id }} .esv-nav__mobile-link:hover {
    color: #ffffff;
  }

  #esv-hero-{{ section.id }} .esv-nav__mobile-actions {
    display: flex;
    gap: 32px;
    margin-top: 40px;
  }

  #esv-hero-{{ section.id }} .esv-nav__mobile-actions .esv-nav__icon-link {
    font-size: calc(14px * var(--esv-text-scale, 1));
    color: rgba(255,255,255, calc(0.6 + var(--esv-muted-boost, 0)));
  }

  /* ── Nav light-state overrides ── */
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav__link {
    color: rgba(8,0,8, calc(0.7 + var(--esv-muted-boost, 0)));
  }
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav__icon-link {
    color: rgba(8,0,8, calc(0.7 + var(--esv-muted-boost, 0)));
  }
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav__hamburger span {
    background: #080008;
  }
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav.scrolled .esv-nav__link,
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav.scrolled .esv-nav__icon-link {
    color: rgba(255,255,255,0.8) !important;
  }
  #esv-hero-{{ section.id }}.esv-hero--light .esv-nav.scrolled .esv-nav__hamburger span {
    background: #ffffff !important;
  }

  /* ── Hero shell ── */
  #esv-hero-{{ section.id }} {
    position: relative;
    height: {{ section.settings.hero_height }}vh;
    background: #ffffff;
    overflow: hidden;
  }

  /* NeatGradient canvas */
  #esv-hero-{{ section.id }} .esv-hero__neat-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Grain texture */
  #esv-hero-{{ section.id }} .esv-hero__noise {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0.055;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    pointer-events: none;
  }

  /* ── Intro overlay ── */
  #esv-hero-{{ section.id }} .esv-hero__intro {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.65s cubic-bezier(0.76, 0, 0.24, 1);
  }

  #esv-hero-{{ section.id }} .esv-hero__intro.esv-intro--hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }

  #esv-hero-{{ section.id }} .esv-intro__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  #esv-hero-{{ section.id }} .esv-intro__stage {
    position: relative;
    width: 500px;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Shared base for both logos */
  #esv-hero-{{ section.id }} .esv-intro__logo-text,
  #esv-hero-{{ section.id }} .esv-intro__logo-icon {
    position: absolute;
    height: auto;
    object-fit: contain;
  }

  /* Text logo — sized to fit comfortably inside the circle */
  #esv-hero-{{ section.id }} .esv-intro__logo-text {
    max-width: 280px;
    width: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Pink icon — sized to match the visual diameter of the laser circle */
  #esv-hero-{{ section.id }} .esv-intro__logo-icon {
    width: 430px;
    max-width: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  #esv-hero-{{ section.id }} .esv-intro__circle-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.8s ease;
    filter: drop-shadow(0 0 3px #FF0000)
            drop-shadow(0 0 8px rgba(255,0,0,0.75))
            drop-shadow(0 0 22px rgba(255,0,0,0.45));
  }


  /* ── Slider track ── */
  #esv-hero-{{ section.id }} .esv-hero__slider {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 200%;
    display: flex;
    z-index: 1;
    will-change: transform;
  }

  #esv-hero-{{ section.id }} .esv-hero__slide {
    width: 50%;
    flex-shrink: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Slide 1 white cover — snaps opaque at forward-slide start */
  #esv-hero-{{ section.id }} .esv-hero__slide1-bg {
    position: absolute;
    inset: 0;
    background: #ffffff;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Slide 2 dark cover — snaps opaque at backward-slide start */
  #esv-hero-{{ section.id }} .esv-hero__slide2-bg {
    position: absolute;
    inset: 0;
    background: #000000;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* ── Content layout — desktop grid ── */
  #esv-hero-{{ section.id }} .esv-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    padding: 120px 40px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    grid-template-areas:
      "eyebrow  product"
      "heading  product"
      "sub      product"
      "cta      product";
    column-gap: 60px;
    row-gap: 24px;
    align-items: start;
  }

  #esv-hero-{{ section.id }} .esv-hero__eyebrow   { grid-area: eyebrow; }
  #esv-hero-{{ section.id }} .esv-hero__heading    { grid-area: heading; }
  #esv-hero-{{ section.id }} .esv-hero__subheading { grid-area: sub; }
  #esv-hero-{{ section.id }} .esv-hero__cta        { grid-area: cta; }
  #esv-hero-{{ section.id }} .esv-hero__product {
    grid-area: product;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
  }

  /* ── Product image ── */
  #esv-hero-{{ section.id }} .esv-hero__product-wrap {
    position: relative;
    width: 100%;
    max-width: 560px;
  }

  #esv-hero-{{ section.id }} .esv-hero__product-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 40px 80px rgba(180,100,255,0.18));
  }

  /* ── Light-state content overrides (slide 1) ── */
  #esv-hero-{{ section.id }} .esv-hero__content--light .esv-hero__heading {
    color: #080008;
  }
  #esv-hero-{{ section.id }} .esv-hero__content--light .esv-hero__subheading {
    color: rgba(8,0,8, calc(0.55 + var(--esv-muted-boost, 0)));
  }
  #esv-hero-{{ section.id }} .esv-hero__content--light .esv-hero__button {
    background: #080008;
    color: #ffffff;
  }
  #esv-hero-{{ section.id }} .esv-hero__content--light .esv-hero__button:hover {
    background: #cc0066;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(204,0,102,0.4);
  }
  #esv-hero-{{ section.id }} .esv-hero__content--light .esv-hero__trust {
    color: rgba(8,0,8, calc(0.35 + var(--esv-muted-boost, 0)));
  }

  /* ── Eyebrow ── */
  #esv-hero-{{ section.id }} .esv-hero__eyebrow {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FF2B5C;
    margin: 0;
  }

  /* ── Heading ── */
  #esv-hero-{{ section.id }} .esv-hero__heading {
    font-size: clamp(2.8rem, 6.5vw, 6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0;
    max-width: 900px;
  }

  /* ── Subheading ── */
  #esv-hero-{{ section.id }} .esv-hero__subheading {
    font-size: calc(clamp(1rem, 1.8vw, 1.2rem) * var(--esv-text-scale, 1));
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255,255,255, calc(0.55 + var(--esv-muted-boost, 0)));
    max-width: 540px;
    margin: 0;
  }

  /* ── CTA group ── */
  #esv-hero-{{ section.id }} .esv-hero__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 540px;
    margin-top: -8px;
  }

  #esv-hero-{{ section.id }} .esv-hero__button {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    background: #ffffff;
    color: #080008;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: 100px;
    transition: background 0.25s, color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  #esv-hero-{{ section.id }} .esv-hero__button:hover {
    background: #cc0066;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(204,0,102,0.4);
  }

  #esv-hero-{{ section.id }} .esv-hero__button:hover .esv-hero__button-arrow {
    transform: translateX(5px);
  }

  #esv-hero-{{ section.id }} .esv-hero__button-arrow {
    display: inline-block;
    transition: transform 0.25s;
  }

  #esv-hero-{{ section.id }} .esv-hero__trust {
    font-size: calc(11px * var(--esv-text-scale, 1));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255, calc(0.3 + var(--esv-muted-boost, 0)));
    margin: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #esv-hero-{{ section.id }} .esv-nav { padding: 14px 14px 0; }
    #esv-hero-{{ section.id }} .esv-nav__links { display: none; }
    #esv-hero-{{ section.id }} .esv-nav__inner { padding: 0 18px; height: 60px; border-radius: 18px; }
    #esv-hero-{{ section.id }} .esv-nav__hamburger { display: flex; }
    #esv-hero-{{ section.id }} .esv-nav__mobile { display: flex; pointer-events: none; }
    #esv-hero-{{ section.id }} .esv-nav__mobile.open { pointer-events: auto; }
    #esv-hero-{{ section.id }} .esv-nav__actions .esv-nav__icon-link { display: none; }

    #esv-hero-{{ section.id }} .esv-hero__neat-canvas {
      transform: scaleY(2);
      transform-origin: center center;
    }

    #esv-hero-{{ section.id }} .esv-hero__content {
      display: flex;
      flex-direction: column;
      padding: 100px 20px 44px;
      gap: 14px;
    }
    #esv-hero-{{ section.id }} .esv-hero__eyebrow    { order: 1; margin-bottom: 18px; }
    #esv-hero-{{ section.id }} .esv-hero__heading    { order: 2; font-size: clamp(2.2rem, 8vw, 3rem); }
    #esv-hero-{{ section.id }} .esv-hero__product    { order: 3; justify-content: center; margin-top: -6px; margin-bottom: -6px; }
    #esv-hero-{{ section.id }} .esv-hero__subheading { order: 4; text-align: center; }
    #esv-hero-{{ section.id }} .esv-hero__cta        { order: 5; align-items: center; text-align: center; }
    #esv-hero-{{ section.id }} .esv-hero__product-img { max-width: 260px; }

    #esv-hero-{{ section.id }} .esv-intro__stage {
      width: 320px;
      height: 320px;
    }
    #esv-hero-{{ section.id }} .esv-intro__logo-text {
      max-width: 180px;
    }
    #esv-hero-{{ section.id }} .esv-intro__logo-icon {
      width: 275px;
    }
  }
</style>

<script>
(function() {

  // ── State ──
  var introComplete = false;
  var slideProgress = 0;       // 0 = slide 1 (light), 1 = slide 2 (dark)
  var slideRunning  = false;
  var SLIDE_DURATION = 1100;
  var slideCompletedAt = 0;    // timestamp of slide 1→2 completion, for grace period

  // Expose to global scroll-snap manager via closure so it reads live values
  window._esvHero = {
    needsWheel: function(deltaY) {
      return !introComplete ||
             slideRunning ||
             (slideProgress === 0 && deltaY > 0) ||
             (slideProgress === 1 && window.scrollY === 0 && deltaY < 0) ||
             (deltaY > 0 && Date.now() - slideCompletedAt < 1200);
    }
  };

  // ── DOM refs ──
  var heroEl     = document.getElementById('esv-hero-{{ section.id }}');
  var sliderEl   = document.getElementById('esv-slider-{{ section.id }}');
  var slide1BgEl = document.getElementById('esv-slide1-bg-{{ section.id }}');
  var slide2BgEl = document.getElementById('esv-slide2-bg-{{ section.id }}');
  var introEl    = document.getElementById('esv-intro-{{ section.id }}');
  var logoTextEl  = introEl ? introEl.querySelector('.esv-intro__logo-text')  : null;
  var logoIconEl  = introEl ? introEl.querySelector('.esv-intro__logo-icon')  : null;
  var circleEl    = introEl ? introEl.querySelector('.esv-intro__circle')     : null;
  var circleSvgEl = introEl ? introEl.querySelector('.esv-intro__circle-svg') : null;
  var neatGrad   = null;

  // ── Nav scroll ──
  var nav = document.getElementById('esv-nav-{{ section.id }}');
  if (nav) {
    window.addEventListener('scroll', function() {
      nav.classList.toggle('scrolled', window.scrollY > 30);
    }, { passive: true });
  }

  // ── Mobile menu ──
  var hamburger  = document.getElementById('esv-hamburger-{{ section.id }}');
  var mobileMenu = document.getElementById('esv-mobile-menu-{{ section.id }}');
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', function() {
      var open = mobileMenu.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', open);
      mobileMenu.setAttribute('aria-hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    });
    mobileMenu.querySelectorAll('.esv-nav__mobile-link').forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.remove('open');
        hamburger.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }

  // ── Scroll lock helpers ──
  function lockScroll() {
    var sbWidth = window.innerWidth - document.documentElement.clientWidth;
    document.body.style.paddingRight = sbWidth + 'px';
    document.body.style.overflow = 'hidden';
  }
  function unlockScroll() {
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
  }

  // ── Push-slide animation ──
  // direction > 0: forward — light slide 1 → dark slide 2
  // direction < 0: backward — dark slide 2 → light slide 1
  function animateSlide(direction) {
    if (slideRunning) return;
    slideRunning = true;
    var startTs = null;
    var startP  = slideProgress;
    var endP    = direction > 0 ? 1 : 0;

    if (direction > 0) {
      // Snap slide1-bg (white) opaque so NeatGradient can safely switch to black
      if (slide1BgEl) { slide1BgEl.style.transition = 'none'; slide1BgEl.style.opacity = '1'; }
      if (neatGrad) neatGrad.backgroundColor = '#000000';
    } else {
      // Switch NeatGradient to white, snap slide2-bg (black) opaque to mask the switch
      if (neatGrad) neatGrad.backgroundColor = '#ffffff';
      if (slide2BgEl) { slide2BgEl.style.transition = 'none'; slide2BgEl.style.opacity = '1'; }
      if (heroEl) heroEl.classList.add('esv-hero--light');
    }

    function tick(ts) {
      if (!startTs) startTs = ts;
      var raw  = Math.min((ts - startTs) / SLIDE_DURATION, 1);
      var ease = raw < 0.5 ? 4*raw*raw*raw : 1 - Math.pow(-2*raw+2, 3)/2;
      slideProgress = startP + (endP - startP) * ease;
      if (sliderEl) sliderEl.style.transform = 'translateX(-' + (slideProgress * 50) + '%)';

      if (raw < 1) {
        requestAnimationFrame(tick);
      } else {
        slideProgress = endP;
        slideRunning  = false;
        if (direction > 0) {
          slideCompletedAt = Date.now();
          // Forward complete: NeatGrad is black, clear slide2-bg (they match so no flash)
          if (slide2BgEl) { slide2BgEl.style.transition = 'none'; slide2BgEl.style.opacity = '0'; }
          if (heroEl) heroEl.classList.remove('esv-hero--light');
          unlockScroll();
        } else {
          // Backward complete: NeatGrad is white, fade slide1-bg (white) away
          if (slide1BgEl) { slide1BgEl.style.transition = 'opacity 0.5s ease'; slide1BgEl.style.opacity = '0'; }
          unlockScroll();
        }
      }
    }
    requestAnimationFrame(tick);
  }

  // ── Scroll intent handler ──
  var touchStartY = 0;

  // True when the hero section is still occupying most of the viewport
  function atHero() {
    if (!heroEl) return window.scrollY < 10;
    return heroEl.getBoundingClientRect().top > -(window.innerHeight * 0.15);
  }

  function onScrollIntent(deltaY) {
    if (!introComplete) return;
    if (slideRunning) return;
    if (deltaY > 0 && slideProgress === 0) {
      lockScroll();
      animateSlide(1);
    } else if (deltaY < 0 && atHero() && slideProgress === 1) {
      lockScroll();
      animateSlide(-1);
    }
  }

  // capture: true guarantees this fires before any bubble-phase listeners (snap manager)
  window.addEventListener('wheel', function(e) {
    var needsControl = !introComplete ||
                       slideRunning ||
                       (slideProgress === 0 && e.deltaY > 0) ||
                       (slideProgress === 1 && atHero() && e.deltaY < 0) ||
                       (e.deltaY > 0 && Date.now() - slideCompletedAt < 1200);
    if (needsControl) {
      e.preventDefault();
      e.stopImmediatePropagation();
    }
    onScrollIntent(e.deltaY);
  }, { passive: false, capture: true });

  window.addEventListener('touchstart', function(e) {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  window.addEventListener('touchmove', function(e) {
    var dy = touchStartY - e.touches[0].clientY;
    var needsControl = !introComplete ||
                       slideRunning ||
                       (slideProgress === 0 && dy > 5) ||
                       (slideProgress === 1 && atHero() && dy < -5) ||
                       (dy > 5 && Date.now() - slideCompletedAt < 1200);
    if (needsControl) {
      e.preventDefault();
      e.stopImmediatePropagation();
    }
    if (introComplete && Math.abs(dy) > 5) {
      onScrollIntent(dy);
      touchStartY = e.touches[0].clientY;
    }
  }, { passive: false, capture: true });

  // ── Intro sequence ──
  function finishIntro() {
    if (introEl) introEl.style.display = 'none';
    if (nav) nav.classList.remove('esv-nav--intro-hidden');
    introComplete = true;
  }

  function runIntro() {
    // t=300ms: fade in text logo (1.2s duration)
    setTimeout(function() {
      if (logoTextEl) logoTextEl.style.opacity = '1';
    }, 300);

    // t=1700ms: start drawing the red laser circle (1.5s linear)
    // Double rAF ensures the CSS transition is in place before dashoffset changes
    setTimeout(function() {
      if (!circleEl) return;
      circleEl.style.transition = 'stroke-dashoffset 1.5s linear';
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          circleEl.style.strokeDashoffset = '0';
        });
      });
    }, 1700);

    // t=3200ms: circle done — fade out text logo + circle together
    setTimeout(function() {
      if (logoTextEl)  logoTextEl.style.opacity  = '0';
      if (circleSvgEl) circleSvgEl.style.opacity = '0';
    }, 3200);

    // t=3800ms: 600ms pause after circle — pink icon fades in
    setTimeout(function() {
      if (logoIconEl) logoIconEl.style.opacity = '1';
    }, 3800);

    // t=7000ms: pink logo visible ~3.2s — slide overlay upward
    setTimeout(function() {
      if (introEl) {
        introEl.classList.add('esv-intro--hidden');
        setTimeout(finishIntro, 700);
      } else {
        finishIntro();
      }
    }, 7000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runIntro);
  } else {
    runIntro();
  }

  // ── NeatGradient animated background ──
  var neatCanvas = document.getElementById('esv-neat-canvas-{{ section.id }}');

  import('https://cdn.jsdelivr.net/npm/@firecms/neat/+esm').then(function(mod) {
    var NeatGradient = mod.NeatGradient;
    neatGrad = new NeatGradient({
      ref: neatCanvas,
      colors: [
        { color: '#FF2B5C', enabled: true  },
        { color: '#EF2AC1', enabled: true  },
        { color: '#7E177C', enabled: true  },
        { color: '#E0115F', enabled: true  },
        { color: '#FFFFFF',  enabled: false },
        { color: '#000000',  enabled: false },
      ],
      speed: 2.5,
      horizontalPressure: 5,
      verticalPressure: 5,
      waveFrequencyX: 2,
      waveFrequencyY: 3,
      waveAmplitude: 6,
      shadows: 2,
      highlights: 0,
      colorBrightness: 0.9,
      colorSaturation: -3,
      wireframe: false,
      colorBlending: 5,
      backgroundColor: '#ffffff',
      backgroundAlpha: 1,
      grainScale: 0,
      grainSparsity: 0,
      grainIntensity: 0,
      grainSpeed: 0,
      resolution: 0.4,
      yOffset: 100,
      yOffsetWaveMultiplier: 1,
      yOffsetColorMultiplier: 4.8,
      yOffsetFlowMultiplier: 5.3,
      flowDistortionA: 3.7,
      flowDistortionB: 0.8,
      flowScale: 1.6,
      flowEase: 0.32,
      flowEnabled: true,
      enableProceduralTexture: false,
      transparentTextureVoid: true,
      textureVoidLikelihood: 0.29,
      textureVoidWidthMin: 120,
      textureVoidWidthMax: 420,
      textureBandDensity: 2.9,
      textureColorBlending: 0.06,
      textureSeed: 536,
      textureEase: 0.93,
      proceduralBackgroundColor: '#775454',
      textureShapeTriangles: 48,
      textureShapeCircles: 15,
      textureShapeBars: 15,
      textureShapeSquiggles: 27,
      domainWarpEnabled: true,
      domainWarpIntensity: 0.1,
      domainWarpScale: 2.4,
      vignetteIntensity: 0.45,
      vignetteRadius: 0.55,
      fresnelEnabled: false,
      fresnelPower: 2.7,
      fresnelIntensity: 1.3,
      fresnelColor: '#F7E7CE',
      iridescenceEnabled: false,
      iridescenceIntensity: 0.5,
      iridescenceSpeed: 1,
      bloomIntensity: 1.9,
      bloomThreshold: 0.6,
      chromaticAberration: 17,
      shapeType: 'ribbon',
      shapeRotationX: 0.348,
      shapeRotationY: -26.783,
      shapeRotationZ: -0.29,
      shapeAutoRotateSpeedX: 0,
      shapeAutoRotateSpeedY: 0,
      sphereRadius: 15,
      torusRadius: 15,
      torusTube: 5,
      cylinderRadius: 10,
      cylinderHeight: 40,
      planeBend: 2.3,
      planeTwist: -2.9,
      silhouetteFade: 0.83,
      cylinderFade: 0.08,
      ribbonFade: 0.31,
      flatShading: false,
      cameraLock: false,
      cameraX: 0,
      cameraY: 0,
      cameraZ: 0,
      cameraRotationX: -0.014,
      cameraRotationY: -0.238,
      cameraRotationZ: 0,
      cameraZoom: 1,
    });
  });

})();
</script>

