<section class="vtabs">
  <div class="vtabs__container">
{% if section.settings.heading != blank or section.settings.subheading != blank %}
  <div class="vtabs__top">
    {% if section.settings.heading != blank %}
      <h2 class="vtabs__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="vtabs__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
{% endif %}
    <div class="vtabs__left">
      {% for block in section.blocks %}
        <button
          class="vtabs__tab {% if forloop.first %}vtabs__tab--active{% endif %}"
          data-vtab="{{ forloop.index }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.icon != blank %}
            <span class="vtabs__tab-icon">{{ block.settings.icon }}</span>
          {% endif %}
          <span class="vtabs__tab-label">{{ block.settings.tab_label }}</span>
        </button>
      {% endfor %}
    </div>

    <div class="vtabs__right">
      {% for block in section.blocks %}
        <div
          class="vtabs__panel {% if forloop.first %}vtabs__panel--active{% endif %}"
          data-vpanel="{{ forloop.index }}"
          role="tabpanel"
          {{ block.shopify_attributes }}
        >
          <div class="vtabs__card">
            {% if block.settings.card_tag != blank %}
              <div class="vtabs__card-tag">
                <span class="vtabs__card-dot"></span>
                {{ block.settings.card_tag }}
              </div>
            {% endif %}

            <div class="vtabs__card-image-wrap {% if block.settings.use_gif_grid %}vtabs__gif-grid{% endif %}">
  {% if block.settings.use_gif_grid %}

    {% if block.settings.gif_1 != blank %}
      {{
        block.settings.gif_1
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          class: 'vtabs__gif',
          alt: block.settings.gif_1.alt
      }}
    {% endif %}

    {% if block.settings.gif_2 != blank %}
      {{
        block.settings.gif_2
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          class: 'vtabs__gif',
          alt: block.settings.gif_2.alt
      }}
    {% endif %}

    {% if block.settings.gif_3 != blank %}
      {{
        block.settings.gif_3
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          class: 'vtabs__gif',
          alt: block.settings.gif_3.alt
      }}
    {% endif %}

    {% if block.settings.gif_4 != blank %}
      {{
        block.settings.gif_4
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          class: 'vtabs__gif',
          alt: block.settings.gif_4.alt
      }}
    {% endif %}

  {% else %}

    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          class: 'vtabs__card-img',
          alt: block.settings.image.alt
      }}
    {% else %}
      <div class="vtabs__card-img-placeholder">
        {{ 'image' | placeholder_svg_tag: 'vtabs__placeholder-svg' }}
      </div>
    {% endif %}

  {% endif %}
</div>

            <div class="vtabs__card-footer">
              {% if block.settings.eyebrow != blank %}
                <p class="vtabs__card-eyebrow">{{ forloop.index }} &bull; {{ block.settings.eyebrow }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="vtabs__card-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a href="{{ block.settings.button_url }}" class="vtabs__card-btn">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% style %}
#shopify-section-{{ section.id }} .vtabs {
  background: #1A1A1A;
}
#shopify-section-{{ section.id }} .vtabs__heading {
  color: #ffffff !important;
}

#shopify-section-{{ section.id }} .vtabs__subheading {
  color: #ffffff !important;
}
  #shopify-section-{{ section.id }} .vtabs__left {
    background-color: {{ section.settings.sidebar_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__tab {
    color: {{ section.settings.tab_text_color }};
    border-color: {{ section.settings.tab_border_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__tab--active {
    background-color: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text }};
    border-color: {{ section.settings.tab_active_bg }};
  }
  #shopify-section-{{ section.id }} .vtabs__card {
    background-color: {{ section.settings.card_bg_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__card-tag,
  #shopify-section-{{ section.id }} .vtabs__card-eyebrow {
    color: {{ section.settings.card_meta_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__card-heading {
    color: {{ section.settings.card_heading_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__card-dot {
    background-color: {{ section.settings.card_meta_color }};
  }
  #shopify-section-{{ section.id }} .vtabs__card-btn {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }
{% endstyle %}

<style>
.vtabs {
  padding: 60px 24px;
  font-family: inherit;
  position: relative;
  overflow: hidden;
}

.vtabs::before {
  content: "";
  position: absolute;
  width: 2200px;
  height: 1100px;
  left: 50%;
  top: 50%;
  background:
    radial-gradient(ellipse at 8% 42%, #E88C82 0%, transparent 46%),
    radial-gradient(ellipse at 28% 60%, #FF2B5C 0%, transparent 44%),
    radial-gradient(ellipse at 50% 34%, #E88C82 0%, transparent 46%),
    radial-gradient(ellipse at 72% 58%, #E88C82 0%, transparent 44%),
    radial-gradient(ellipse at 92% 38%, #FF2B5C 0%, transparent 46%);
  opacity: 0.62;
  filter: blur(48px);
  border-radius: 48% 52% 58% 42%;
  animation: vtabsGlowMove 12s linear infinite;
  pointer-events: none;
}

@keyframes vtabsGlowMove {
  0% {
    opacity: 0.42;
    transform: translate(-62%, -56%) rotate(0deg) scale(0.96);
    border-radius: 48% 52% 58% 42%;
  }

  25% {
    opacity: 0.75;
    transform: translate(-54%, -60%) rotate(8deg) scale(1.04);
    border-radius: 62% 38% 46% 54%;
  }

  50% {
    opacity: 0.66;
    transform: translate(-45%, -50%) rotate(-8deg) scale(1.1);
    border-radius: 38% 62% 56% 44%;
  }

  75% {
    opacity: 0.8;
    transform: translate(-36%, -44%) rotate(10deg) scale(1.05);
    border-radius: 56% 44% 36% 64%;
  }

  100% {
    opacity: 0.42;
    transform: translate(-62%, -56%) rotate(0deg) scale(0.96);
    border-radius: 48% 52% 58% 42%;
  }
}

.vtabs__container {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 32px;
  align-items: start;
  position: relative;
  z-index: 1;
}
  .vtabs__top {
  grid-column: 1 / -1;
  text-align: center;
  margin-bottom: 16px;
}

.vtabs__heading {
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  margin: 0;
}

.vtabs__subheading {
  font-size: 17px;
  line-height: 1.6;
  margin: 12px auto 0;
  max-width: 560px;
}
  /* Left sidebar */
  .vtabs__left {
    border-radius: 24px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
 .vtabs__tab {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 16px 20px;
  border-radius: 999px;
  border: 1px solid;
  background: transparent;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  transition: color 0.2s ease, border-color 0.2s ease;
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.vtabs__tab::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: #FF2B5C;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 1.1s ease;
  z-index: -1;
}

.vtabs__tab:hover:not(.vtabs__tab--active)::before {
  transform: scaleX(1);
}

.vtabs__tab:hover:not(.vtabs__tab--active) {
  color: {{ section.settings.tab_active_text }};
  border-color: #FF2B5C;
}

.vtabs__tab--active::before {
  transform: scaleX(0);
}
.vtabs__tab-icon {
  font-size: 18px;
  flex-shrink: 0;
  width: 28px;
  text-align: center;
  position: relative;
  z-index: 1;
}

.vtabs__tab-label {
  flex: 1;
  position: relative;
  z-index: 1;
}
  /* Right panel */
  .vtabs__right {
    position: relative;
  }
  .vtabs__panel {
    display: none;
  }
  .vtabs__panel--active {
    display: block;
  }
  .vtabs__card {
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  /* Card top tag */
  .vtabs__card-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 16px 20px 0;
  }
  .vtabs__card-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
.vtabs__card-image-wrap {
  height: 640px;
  overflow: hidden;
  background: #222;
  padding: 20px;
  box-sizing: border-box;
}
.vtabs__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.vtabs__gif-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 0;
}

.vtabs__gif {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
  .vtabs__card-img-placeholder {
    width: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.05);
  }
  .vtabs__placeholder-svg {
    width: 40%;
    opacity: 0.15;
  }
  /* Card footer */
  .vtabs__card-footer {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vtabs__card-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  .vtabs__card-heading {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .vtabs__card-btn {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 10px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    margin-top: 4px;
    transition: opacity 0.2s ease;
  }
  .vtabs__card-btn:hover { opacity: 0.8; }
  /* Responsive */
  @media (max-width: 900px) {
    .vtabs__container {
      grid-template-columns: 1fr;
    }
    .vtabs__left {
      flex-direction: row;
      flex-wrap: wrap;
      border-radius: 16px;
    }
    .vtabs__tab {
      width: auto;
      flex: 1 1 auto;
      min-width: 140px;
      justify-content: center;
      border-radius: 999px;
    }
  }
  @media (max-width: 480px) {
    .vtabs { padding: 40px 16px; }
    .vtabs__tab { font-size: 12px; padding: 12px 14px; }
  }
#shopify-section-{{ section.id }} .vtabs__tab {
  background: #E88C82 !important;
  color: #ffffff !important;
  border-color: #E88C82 !important;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  transition: border-color 0.2s ease, color 0.2s ease;
}

#shopify-section-{{ section.id }} .vtabs__tab::before {
  content: "";
  position: absolute;
  inset: 0;
  background: #D9234F;
  border-radius: inherit;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 1s linear;
  z-index: -1;
}

#shopify-section-{{ section.id }} .vtabs__tab:hover:not(.vtabs__tab--active)::before {
  transform: scaleX(1);
}

#shopify-section-{{ section.id }} .vtabs__tab:hover:not(.vtabs__tab--active) {
  color: #ffffff !important;
  border-color: #D9234F !important;
}

#shopify-section-{{ section.id }} .vtabs__tab--active {
  background: #FF2B5C !important;
  color: #ffffff !important;
  border-color: #FF2B5C !important;
}

#shopify-section-{{ section.id }} .vtabs__tab--active::before {
  display: none;
}

#shopify-section-{{ section.id }} .vtabs__tab-icon,
#shopify-section-{{ section.id }} .vtabs__tab-label {
  position: relative;
  z-index: 1;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var tabs = section.querySelectorAll('.vtabs__tab');
    var panels = section.querySelectorAll('.vtabs__panel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var idx = tab.getAttribute('data-vtab');
        tabs.forEach(function (t) {
          t.classList.remove('vtabs__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function (p) { p.classList.remove('vtabs__panel--active'); });
        tab.classList.add('vtabs__tab--active');
        tab.setAttribute('aria-selected', 'true');
        var panel = section.querySelector('.vtabs__panel[data-vpanel="' + idx + '"]');
        if (panel) panel.classList.add('vtabs__panel--active');
      });
    });
  });
</script>

