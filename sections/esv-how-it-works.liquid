    },
    {
      "type": "header",
      "content": "Specs Strip"
    },
    {
      "type": "text",
      "id": "spec_1_value",
      "label": "Spec 1 value",
      "default": "5–6 min"
    },
    {
      "type": "text",
      "id": "spec_1_label",
      "label": "Spec 1 label",
