<section class="esv-hiw" id="esv-hiw-{{ section.id }}">
  <div class="esv-hiw__container">

    <!-- Header -->
    <div class="esv-hiw__header esv-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="esv-hiw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="esv-hiw__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="esv-hiw__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Circular gallery -->
    <div class="esv-hiw__gallery esv-reveal" id="esv-hiw-gallery-{{ section.id }}">
      <div class="esv-hiw__gallery-stage">
        <div class="esv-hiw__gallery-ring" id="esv-hiw-ring-{{ section.id }}">

          <button type="button" class="esv-hiw__gallery-card" style="--i: 0;"
            data-num="01"
            data-title="{{ section.settings.step_4_title | escape }}"
            data-body="{{ section.settings.step_4_body | escape }}">
            <div class="esv-hiw__gallery-img-wrap">
              {%- if section.settings.step_4_image != blank -%}
                <img class="esv-hiw__gallery-img" src="{{ section.settings.step_4_image }}" alt="{{ section.settings.step_4_title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="esv-hiw__gallery-caption">
                <span class="esv-hiw__gallery-num">01</span>
                <h3 class="esv-hiw__gallery-title">{{ section.settings.step_4_title }}</h3>
              </div>
            </div>
          </button>

          <button type="button" class="esv-hiw__gallery-card" style="--i: 1;"
            data-num="02"
            data-title="{{ section.settings.step_1_title | escape }}"
            data-body="{{ section.settings.step_1_body | escape }}">
            <div class="esv-hiw__gallery-img-wrap">
              {%- if section.settings.step_1_image != blank -%}
                <img class="esv-hiw__gallery-img" src="{{ section.settings.step_1_image }}" alt="{{ section.settings.step_1_title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="esv-hiw__gallery-caption">
                <span class="esv-hiw__gallery-num">02</span>
                <h3 class="esv-hiw__gallery-title">{{ section.settings.step_1_title }}</h3>
              </div>
            </div>
          </button>

          <button type="button" class="esv-hiw__gallery-card" style="--i: 2;"
            data-num="03"
            data-title="{{ section.settings.step_5_title | escape }}"
            data-body="{{ section.settings.step_5_body | escape }}">
            <div class="esv-hiw__gallery-img-wrap">
              {%- if section.settings.step_5_image != blank -%}
                <img class="esv-hiw__gallery-img" src="{{ section.settings.step_5_image }}" alt="{{ section.settings.step_5_title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="esv-hiw__gallery-caption">
                <span class="esv-hiw__gallery-num">03</span>
                <h3 class="esv-hiw__gallery-title">{{ section.settings.step_5_title }}</h3>
              </div>
            </div>
          </button>

          <button type="button" class="esv-hiw__gallery-card" style="--i: 3;"
            data-num="04"
            data-title="{{ section.settings.step_2_title | escape }}"
            data-body="{{ section.settings.step_2_body | escape }}">
            <div class="esv-hiw__gallery-img-wrap">
              {%- if section.settings.step_2_image != blank -%}
                <img class="esv-hiw__gallery-img" src="{{ section.settings.step_2_image }}" alt="{{ section.settings.step_2_title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="esv-hiw__gallery-caption">
                <span class="esv-hiw__gallery-num">04</span>
                <h3 class="esv-hiw__gallery-title">{{ section.settings.step_2_title }}</h3>
              </div>
            </div>
          </button>

          <button type="button" class="esv-hiw__gallery-card" style="--i: 4;"
            data-num="05"
            data-title="{{ section.settings.step_3_title | escape }}"
            data-body="{{ section.settings.step_3_body | escape }}">
            <div class="esv-hiw__gallery-img-wrap">
              {%- if section.settings.step_3_image != blank -%}
                <img class="esv-hiw__gallery-img" src="{{ section.settings.step_3_image }}" alt="{{ section.settings.step_3_title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="esv-hiw__gallery-caption">
                <span class="esv-hiw__gallery-num">05</span>
                <h3 class="esv-hiw__gallery-title">{{ section.settings.step_3_title }}</h3>
              </div>
            </div>
          </button>

          {%- if section.settings.center_image != blank -%}
            <img class="esv-hiw__center-img"
              src="{{ section.settings.center_image | image_url: width: 600 }}"
              alt="{{ section.settings.center_image.alt | default: 'Eye Star Vision device' | escape }}"
              draggable="false">
          {%- endif -%}

        </div>
      </div>
    </div>

    <!-- Step description panel (2D — outside 3D context for crisp rendering) -->
    <div class="esv-hiw__desc" id="esv-hiw-desc-{{ section.id }}" aria-live="polite">
      <span class="esv-hiw__desc-num"></span>
      <div class="esv-hiw__desc-text">
        <h3 class="esv-hiw__desc-title"></h3>
        <p class="esv-hiw__desc-body"></p>
      </div>
      <button type="button" class="esv-hiw__desc-close" aria-label="Close">&#x2715;</button>
    </div>

    <!-- Specs strip -->
    <div class="esv-hiw__specs esv-reveal">
      <div class="esv-hiw__spec">
        <span class="esv-hiw__spec-value">{{ section.settings.spec_1_value }}</span>
        <span class="esv-hiw__spec-label">{{ section.settings.spec_1_label }}</span>
      </div>
      <div class="esv-hiw__spec-sep"></div>
      <div class="esv-hiw__spec">
        <span class="esv-hiw__spec-value">{{ section.settings.spec_2_value }}</span>
        <span class="esv-hiw__spec-label">{{ section.settings.spec_2_label }}</span>
      </div>
      <div class="esv-hiw__spec-sep"></div>
      <div class="esv-hiw__spec">
        <span class="esv-hiw__spec-value">{{ section.settings.spec_3_value }}</span>
        <span class="esv-hiw__spec-label">{{ section.settings.spec_3_label }}</span>
      </div>
      <div class="esv-hiw__spec-sep"></div>
      <div class="esv-hiw__spec">
        <span class="esv-hiw__spec-value">{{ section.settings.spec_4_value }}</span>
        <span class="esv-hiw__spec-label">{{ section.settings.spec_4_label }}</span>
      </div>
      <div class="esv-hiw__spec-sep"></div>
      <div class="esv-hiw__spec">
        <span class="esv-hiw__spec-value">{{ section.settings.spec_5_value }}</span>
        <span class="esv-hiw__spec-label">{{ section.settings.spec_5_label }}</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* Zero out the Dawn .section wrapper padding so 100svh is truly the full height */
  #shopify-section-{{ section.id }} {
    padding: 0 !important;
  }

  #esv-hiw-{{ section.id }} {
    background: #f4f3f7;
    padding: 48px 40px 40px;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__container {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Header ── */
  #esv-hiw-{{ section.id }} .esv-hiw__header {
    max-width: 680px;
    margin-bottom: 80px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__eyebrow {
    font-size: clamp(0.75rem, 1.2vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FF2B5C;
    margin: 0 0 20px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__heading {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #111111;
    margin: 0 0 24px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__subheading {
    font-size: calc(clamp(1rem, 1.6vw, 1.15rem) * var(--esv-text-scale, 1));
    line-height: 1.7;
    color: rgba(17,17,17, calc(0.55 + var(--esv-muted-boost, 0)));
    margin: 0;
    max-width: 560px;
  }

  /* ── Circular gallery ── */
  #esv-hiw-{{ section.id }} .esv-hiw__gallery {
    margin-bottom: 52px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-stage {
    position: relative;
    height: 340px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    --esv-radius: 360;
  }

  /* ── Centre product image ── */
  #esv-hiw-{{ section.id }} .esv-hiw__center-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 240px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
    z-index: 50;
    filter: drop-shadow(0 24px 48px rgba(0,0,0,0.35));
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 330px;
    height: 440px;
    margin: -270px 0 0 -165px;
    border-radius: 20px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background: #1a1a1a;
    box-shadow: 0 24px 48px rgba(0,0,0,0.18);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-card.is-active {
    border-color: #FF2B5C;
    box-shadow: 0 24px 48px rgba(0,0,0,0.18), 0 0 0 3px rgba(255,43,92,0.25);
  }

  /* ── Image layer ── */
  #esv-hiw-{{ section.id }} .esv-hiw__gallery-img-wrap {
    position: absolute;
    inset: 0;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 20px;
    text-align: left;
    background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0));
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-num {
    display: block;
    font-size: calc(0.75rem * var(--esv-text-scale, 1));
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #FF2B5C;
    margin-bottom: 6px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__gallery-title {
    font-size: calc(1.15rem * var(--esv-text-scale, 1));
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  /* ── 2D description panel (outside 3D context — renders at full native resolution) ── */
  #esv-hiw-{{ section.id }} .esv-hiw__desc {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: #111111;
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 16px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-num {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #FF2B5C;
    white-space: nowrap;
    padding-top: 3px;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-text {
    flex: 1;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-title {
    font-size: calc(1rem * var(--esv-text-scale, 1));
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 6px;
    line-height: 1.25;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-body {
    font-size: calc(0.82rem * var(--esv-text-scale, 1));
    line-height: 1.6;
    color: rgba(255,255,255,0.68);
    margin: 0;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-close {
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-size: 1rem;
    cursor: pointer;
    padding: 2px 0 0 8px;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__desc-close:hover {
    color: rgba(255,255,255,0.85);
  }

  /* ── Specs strip ── */
  #esv-hiw-{{ section.id }} .esv-hiw__specs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    border: 1px solid rgba(0,0,0,0.09);
    border-radius: 20px;
    padding: 20px 40px;
    background: rgba(0,0,0,0.03);
  }

  #esv-hiw-{{ section.id }} .esv-hiw__spec {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex: 1;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__spec-value {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111111;
    line-height: 1;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__spec-label {
    font-size: calc(0.72rem * var(--esv-text-scale, 1));
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(17,17,17, calc(0.45 + var(--esv-muted-boost, 0)));
    text-align: center;
  }

  #esv-hiw-{{ section.id }} .esv-hiw__spec-sep {
    width: 1px;
    height: 40px;
    background: rgba(0,0,0,0.1);
    flex-shrink: 0;
  }

  /* ── Scroll-reveal ── */
  #esv-hiw-{{ section.id }} .esv-reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #esv-hiw-{{ section.id }} .esv-reveal--delay-1 { transition-delay: 0.1s; }
  #esv-hiw-{{ section.id }} .esv-reveal--delay-2 { transition-delay: 0.22s; }
  #esv-hiw-{{ section.id }} .esv-reveal--delay-3 { transition-delay: 0.34s; }
  #esv-hiw-{{ section.id }} .esv-reveal.esv-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-stage {
      height: 300px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-card {
      width: 200px;
      height: 280px;
      margin: -140px 0 0 -100px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__specs {
      flex-wrap: wrap;
      gap: 24px;
      padding: 28px 24px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__spec-sep { display: none; }
    #esv-hiw-{{ section.id }} .esv-hiw__spec { flex: 0 0 calc(33% - 16px); }
  }

  @media (max-width: 749px) {
    #esv-hiw-{{ section.id }} {
      height: auto;
      overflow: visible;
      display: block;
      padding: 40px 16px 44px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__header {
      margin-bottom: 16px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery {
      margin-bottom: 20px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-ring {
      --esv-radius: 240;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-stage {
      height: 240px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-card {
      width: 150px;
      height: 210px;
      margin: -105px 0 0 -75px;
      border-radius: 16px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-caption {
      padding: 14px;
    }
    #esv-hiw-{{ section.id }} .esv-hiw__gallery-title {
      font-size: calc(0.95rem * var(--esv-text-scale, 1));
    }
    #esv-hiw-{{ section.id }} .esv-hiw__spec { flex: 0 0 calc(50% - 12px); }
    #esv-hiw-{{ section.id }} .esv-hiw__specs { padding: 18px 16px; }
  }
</style>

<script>
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('esv-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('#esv-hiw-{{ section.id }} .esv-reveal').forEach(function(el) {
    observer.observe(el);
  });
})();

(function() {
  var ITEMS      = 5;
  var ANGLE_STEP = (2 * Math.PI) / ITEMS; /* radians */
  var SPEED      = 0.028 * Math.PI / 180; /* deg→rad */
  var RADIUS     = 360;
  var MIN_SCALE  = 0.72;  /* scale of back cards */
  var MIN_OPACITY = 0.28;

  var ring      = document.getElementById('esv-hiw-ring-{{ section.id }}');
  var desc      = document.getElementById('esv-hiw-desc-{{ section.id }}');
  var cards     = ring ? Array.from(ring.querySelectorAll('.esv-hiw__gallery-card')) : [];

  if (!ring || !cards.length) return;

  function readRadius() {
    var v = getComputedStyle(ring).getPropertyValue('--esv-radius').trim();
    return v ? parseFloat(v) : 360;
  }
  RADIUS = readRadius();
  window.addEventListener('resize', function() { RADIUS = readRadius(); });

  var descNum   = desc ? desc.querySelector('.esv-hiw__desc-num')   : null;
  var descTitle = desc ? desc.querySelector('.esv-hiw__desc-title') : null;
  var descBody  = desc ? desc.querySelector('.esv-hiw__desc-body')  : null;
  var descClose = desc ? desc.querySelector('.esv-hiw__desc-close') : null;

  var rotation   = 0; /* in radians */
  var paused     = false;
  var rafId      = null;
  var activeCard = null;
  var animating  = false;

  function applyPositions() {
    cards.forEach(function(card, i) {
      var angle = i * ANGLE_STEP + rotation;
      var x     = Math.sin(angle) * RADIUS;
      var depth = (Math.cos(angle) + 1) / 2; /* 0..1, 1 = front */
      var scale = MIN_SCALE + (1 - MIN_SCALE) * depth;
      var opacity = Math.max(MIN_OPACITY, depth);
      card.style.transform = 'translateX(' + x.toFixed(2) + 'px) scale(' + scale.toFixed(4) + ')';
      card.style.opacity   = opacity.toFixed(3);
      card.style.zIndex    = Math.round(depth * 99);
    });
  }

  function tick() {
    if (!paused) rotation -= SPEED;
    applyPositions();
    rafId = requestAnimationFrame(tick);
  }

  /* Shortest-path target angle to bring card i to front (angle = 0 or 2π) */
  function targetRotationFor(i) {
    var base = -i * ANGLE_STEP;
    var diff = ((base - rotation) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
    if (diff > Math.PI) diff -= 2 * Math.PI;
    return rotation + diff;
  }

  function showDesc(card) {
    if (!desc) return;
    if (descNum)   descNum.textContent   = card.dataset.num   || '';
    if (descTitle) descTitle.textContent = card.dataset.title || '';
    if (descBody)  descBody.textContent  = card.dataset.body  || '';
    desc.classList.add('is-visible');
  }

  function hideDesc() {
    if (desc) desc.classList.remove('is-visible');
  }

  function deactivate(resumeAfter) {
    if (!activeCard) return;
    activeCard.classList.remove('is-active');
    hideDesc();
    activeCard = null;
    if (resumeAfter) {
      setTimeout(function() { paused = false; }, 400);
    }
  }

  function activate(card, i) {
    if (animating) return;

    if (activeCard) {
      activeCard.classList.remove('is-active');
      hideDesc();
      activeCard = null;
    }

    paused     = true;
    activeCard = card;

    var targetRot = targetRotationFor(i);
    var delta     = Math.abs(targetRot - rotation);

    if (delta > 0.01) {
      animating = true;
      cancelAnimationFrame(rafId);
      rafId = null;

      var startRot  = rotation;
      var startTime = null;
      var duration  = 700;

      function animateTo(ts) {
        if (!startTime) startTime = ts;
        var t = Math.min((ts - startTime) / duration, 1);
        /* ease in-out cubic */
        var e = t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3) / 2;
        rotation = startRot + (targetRot - startRot) * e;
        applyPositions();
        if (t < 1) {
          rafId = requestAnimationFrame(animateTo);
        } else {
          rotation  = targetRot;
          animating = false;
          card.classList.add('is-active');
          showDesc(card);
          rafId = requestAnimationFrame(tick);
        }
      }
      rafId = requestAnimationFrame(animateTo);

    } else {
      card.classList.add('is-active');
      showDesc(card);
    }
  }

  cards.forEach(function(card, i) {
    card.addEventListener('click', function() {
      if (card === activeCard) {
        deactivate(true);
      } else {
        activate(card, i);
      }
    });
  });

  if (descClose) {
    descClose.addEventListener('click', function() { deactivate(true); });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && activeCard) deactivate(true);
  });

  rafId = requestAnimationFrame(tick);
})();
</script>

{% schema %}
{
  "name": "ESV — How It Works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "heading",
