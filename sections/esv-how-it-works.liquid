    },
    {
      "type": "text",
      "id": "spec_2_value",
      "label": "Spec 2 value",
      "default": "6× daily"
    },
    {
      "type": "text",
      "id": "spec_2_label",
      "label": "Spec 2 label",
      "default": "Recommended"
    },
    {
      "type": "text",
      "id": "spec_3_value",
      "label": "Spec 3 value",
      "default": "Up to 50°"
    },
    {
      "type": "text",
      "id": "spec_3_label",
      "label": "Spec 3 label",
      "default": "Movement range"
    },
    {
      "type": "text",
      "id": "spec_4_value",
      "label": "Spec 4 value",
      "default": "~20°/s"
    },
    {
      "type": "text",
      "id": "spec_4_label",
      "label": "Spec 4 label",
      "default": "Stimulus speed"
    },
    {
      "type": "text",
      "id": "spec_5_value",
      "label": "Spec 5 value",
      "default": "No screen"
    },
    {
      "type": "text",
      "id": "spec_5_label",
      "label": "Spec 5 label",
      "default": "Required"
    }
  ],
  "presets": [
    {
      "name": "ESV — How It Works"
    }
  ]
}
{% endschema %}
