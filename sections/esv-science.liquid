<section class="esv-science" id="esv-science-{{ section.id }}">
  <div class="esv-science__container">

    <!-- Header -->
    <div class="esv-science__header esv-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="esv-science__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="esv-science__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="esv-science__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Study stats row -->
    <div class="esv-science__stats esv-reveal esv-reveal--delay-1">
      <div class="esv-science__stat">
        <span class="esv-science__stat-num" data-count="{{ section.settings.stat_1_number }}">{{ section.settings.stat_1_number }}</span>
        <span class="esv-science__stat-suffix">{{ section.settings.stat_1_suffix }}</span>
        <span class="esv-science__stat-label">{{ section.settings.stat_1_label }}</span>
      </div>
      <div class="esv-science__stat-divider"></div>
      <div class="esv-science__stat">
        <span class="esv-science__stat-num">{{ section.settings.stat_2_number }}</span>
        <span class="esv-science__stat-suffix">{{ section.settings.stat_2_suffix }}</span>
        <span class="esv-science__stat-label">{{ section.settings.stat_2_label }}</span>
      </div>
      <div class="esv-science__stat-divider"></div>
      <div class="esv-science__stat">
        <span class="esv-science__stat-num">{{ section.settings.stat_3_number }}</span>
        <span class="esv-science__stat-suffix">{{ section.settings.stat_3_suffix }}</span>
        <span class="esv-science__stat-label">{{ section.settings.stat_3_label }}</span>
      </div>
      <div class="esv-science__stat-divider"></div>
      <div class="esv-science__stat">
        <span class="esv-science__stat-num">{{ section.settings.stat_4_number }}</span>
        <span class="esv-science__stat-suffix">{{ section.settings.stat_4_suffix }}</span>
        <span class="esv-science__stat-label">{{ section.settings.stat_4_label }}</span>
      </div>
    </div>

    <!-- Study card -->
    <div class="esv-science__study esv-reveal esv-reveal--delay-2">
      <div class="esv-science__study-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        {{ section.settings.study_badge }}
      </div>
      <div class="esv-science__study-body">
        <h3 class="esv-science__study-title">{{ section.settings.study_title }}</h3>
        <p class="esv-science__study-text">{{ section.settings.study_text }}</p>
      </div>
      <div class="esv-science__study-meta">
        <p class="esv-science__study-source">{{ section.settings.study_source }}</p>
        <p class="esv-science__study-funding">{{ section.settings.study_funding }}</p>
        {%- if section.settings.study_link_label != blank and section.settings.study_link_url != blank -%}
          <a href="{{ section.settings.study_link_url }}" class="esv-science__study-link" target="_blank" rel="noopener">
            {{ section.settings.study_link_label }}
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 15L15 5M15 5H8M15 5v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Patents -->
    <div class="esv-science__patents esv-reveal">
      <div class="esv-science__patents-header">
        <h3 class="esv-science__patents-heading">{{ section.settings.patents_heading }}</h3>
        <p class="esv-science__patents-sub">{{ section.settings.patents_subheading }}</p>
      </div>
      <div class="esv-science__patents-grid">

        <div class="esv-science__patent esv-reveal esv-reveal--delay-1">
          <div class="esv-science__patent-flag">US</div>
          <div class="esv-science__patent-info">
            <span class="esv-science__patent-num">{{ section.settings.patent_1_number }}</span>
            <span class="esv-science__patent-region">{{ section.settings.patent_1_region }}</span>
          </div>
        </div>

        <div class="esv-science__patent esv-reveal esv-reveal--delay-2">
          <div class="esv-science__patent-flag">EU</div>
          <div class="esv-science__patent-info">
            <span class="esv-science__patent-num">{{ section.settings.patent_2_number }}</span>
            <span class="esv-science__patent-region">{{ section.settings.patent_2_region }}</span>
          </div>
        </div>

        <div class="esv-science__patent esv-reveal esv-reveal--delay-3">
          <div class="esv-science__patent-flag">CA</div>
          <div class="esv-science__patent-info">
            <span class="esv-science__patent-num">{{ section.settings.patent_3_number }}</span>
            <span class="esv-science__patent-region">{{ section.settings.patent_3_region }}</span>
          </div>
        </div>

        <div class="esv-science__patent esv-reveal esv-reveal--delay-3">
          <div class="esv-science__patent-flag">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2 12h20M12 2c-2.5 3-4 6-4 10s1.5 7 4 10M12 2c2.5 3 4 6 4 10s-1.5 7-4 10" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="esv-science__patent-info">
            <span class="esv-science__patent-num">{{ section.settings.patent_4_number }}</span>
            <span class="esv-science__patent-region">{{ section.settings.patent_4_region }}</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Disclaimer -->
    {%- if section.settings.disclaimer != blank -%}
      <p class="esv-science__disclaimer esv-reveal">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

  </div>
</section>

<style>
  #esv-science-{{ section.id }} {
    background: #f4f3f7;
    padding: 120px 40px;
  }

  #esv-science-{{ section.id }} .esv-science__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Header ── */
  #esv-science-{{ section.id }} .esv-science__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 72px;
  }

  #esv-science-{{ section.id }} .esv-science__eyebrow {
    font-size: clamp(0.75rem, 1.2vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FF2B5C;
    margin: 0 0 20px;
  }

  #esv-science-{{ section.id }} .esv-science__heading {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #111111;
    margin: 0 0 24px;
  }

  #esv-science-{{ section.id }} .esv-science__subheading {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.7;
    color: rgba(17,17,17,0.55);
    margin: 0;
  }

  /* ── Stats row ── */
  #esv-science-{{ section.id }} .esv-science__stats {
    display: flex;
    align-items: stretch;
    border: 1px solid rgba(0,0,0,0.09);
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 24px;
    background: rgba(0,0,0,0.03);
  }

  #esv-science-{{ section.id }} .esv-science__stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 32px;
    gap: 4px;
  }

  #esv-science-{{ section.id }} .esv-science__stat-num {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #111111;
    line-height: 1;
  }

  #esv-science-{{ section.id }} .esv-science__stat-suffix {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 800;
    color: #FF2B5C;
    line-height: 1;
    margin-top: -4px;
  }

  #esv-science-{{ section.id }} .esv-science__stat-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(17,17,17,0.45);
    margin-top: 8px;
    text-align: center;
  }

  #esv-science-{{ section.id }} .esv-science__stat-divider {
    width: 1px;
    background: rgba(0,0,0,0.1);
    flex-shrink: 0;
  }

  /* ── Study card ── */
  #esv-science-{{ section.id }} .esv-science__study {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0;
    align-items: start;
    border: 1px solid rgba(0,0,0,0.09);
    border-radius: 24px;
    padding: 48px;
    margin-bottom: 72px;
    background: rgba(0,0,0,0.03);
    column-gap: 48px;
  }

  #esv-science-{{ section.id }} .esv-science__study-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FF2B5C;
    background: rgba(255,43,92,0.1);
    border: 1px solid rgba(255,43,92,0.2);
    border-radius: 100px;
    padding: 10px 18px;
    white-space: nowrap;
    align-self: start;
  }

  #esv-science-{{ section.id }} .esv-science__study-title {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111111;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  #esv-science-{{ section.id }} .esv-science__study-text {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(17,17,17,0.55);
    margin: 0;
  }

  #esv-science-{{ section.id }} .esv-science__study-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 240px;
    border-left: 1px solid rgba(0,0,0,0.09);
    padding-left: 48px;
  }

  #esv-science-{{ section.id }} .esv-science__study-source {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(17,17,17,0.65);
    margin: 0;
    line-height: 1.5;
  }

  #esv-science-{{ section.id }} .esv-science__study-funding {
    font-size: 0.75rem;
    color: rgba(17,17,17,0.4);
    margin: 0;
    line-height: 1.5;
  }

  #esv-science-{{ section.id }} .esv-science__study-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #FF2B5C;
    text-decoration: none;
    margin-top: 8px;
    transition: opacity 0.2s;
  }

  #esv-science-{{ section.id }} .esv-science__study-link:hover {
    opacity: 0.75;
  }

  /* ── Patents ── */
  #esv-science-{{ section.id }} .esv-science__patents-header {
    margin-bottom: 32px;
  }

  #esv-science-{{ section.id }} .esv-science__patents-heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111111;
    margin: 0 0 10px;
  }

  #esv-science-{{ section.id }} .esv-science__patents-sub {
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(17,17,17,0.5);
    margin: 0;
    max-width: 640px;
  }

  #esv-science-{{ section.id }} .esv-science__patents-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  #esv-science-{{ section.id }} .esv-science__patent {
    display: flex;
    align-items: center;
    gap: 20px;
    background: rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.09);
    border-radius: 18px;
    padding: 28px 24px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  #esv-science-{{ section.id }} .esv-science__patent:hover {
    background: rgba(0,0,0,0.07);
    border-color: rgba(255,43,92,0.2);
  }

  #esv-science-{{ section.id }} .esv-science__patent-flag {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FF2B5C;
    background: rgba(255,43,92,0.1);
    border: 1px solid rgba(255,43,92,0.2);
    border-radius: 8px;
    padding: 6px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    flex-shrink: 0;
  }

  #esv-science-{{ section.id }} .esv-science__patent-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #esv-science-{{ section.id }} .esv-science__patent-num {
    font-size: 0.78rem;
    font-weight: 700;
    color: rgba(17,17,17,0.7);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  #esv-science-{{ section.id }} .esv-science__patent-region {
    font-size: 0.7rem;
    color: rgba(17,17,17,0.4);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── Disclaimer ── */
  #esv-science-{{ section.id }} .esv-science__disclaimer {
    font-size: 0.72rem;
    line-height: 1.6;
    color: rgba(17,17,17,0.3);
    text-align: center;
    max-width: 760px;
    margin: 48px auto 0;
  }

  /* ── Scroll-reveal ── */
  #esv-science-{{ section.id }} .esv-reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #esv-science-{{ section.id }} .esv-reveal--delay-1 { transition-delay: 0.1s; }
  #esv-science-{{ section.id }} .esv-reveal--delay-2 { transition-delay: 0.22s; }
  #esv-science-{{ section.id }} .esv-reveal--delay-3 { transition-delay: 0.34s; }
  #esv-science-{{ section.id }} .esv-reveal.esv-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    #esv-science-{{ section.id }} .esv-science__study {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    #esv-science-{{ section.id }} .esv-science__study-meta {
      border-left: none;
      border-top: 1px solid rgba(0,0,0,0.09);
      padding-left: 0;
      padding-top: 32px;
    }
    #esv-science-{{ section.id }} .esv-science__patents-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    #esv-science-{{ section.id }} {
      padding: 80px 20px;
    }
    #esv-science-{{ section.id }} .esv-science__header {
      margin-bottom: 48px;
    }
    #esv-science-{{ section.id }} .esv-science__stats {
      flex-direction: column;
    }
    #esv-science-{{ section.id }} .esv-science__stat {
      padding: 32px 24px;
    }
    #esv-science-{{ section.id }} .esv-science__stat-divider {
      width: 100%;
      height: 1px;
    }
    #esv-science-{{ section.id }} .esv-science__study {
      padding: 32px 24px;
    }
    #esv-science-{{ section.id }} .esv-science__patents-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('esv-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#esv-science-{{ section.id }} .esv-reveal').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>

{% schema %}
