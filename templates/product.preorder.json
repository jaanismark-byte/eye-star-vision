    "3713e29a-195e-4401-921e-9f6dd0dcc6ba": {
      "type": "multicolumn",
      "blocks": {
        "template--21538193178908__3713e29a-195e-4401-921e-9f6dd0dcc6ba-column-1": {
          "type": "column",
          "settings": {
            "title": "Relieves screen-induced discomfort",
            "text": "<p>Guides your eyes through natural movement patterns that help reduce tension and discomfort caused by prolonged screen use.<br/>It gives your eyes a break without needing apps, filters, or extra software.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "template--21538193178908__3713e29a-195e-4401-921e-9f6dd0dcc6ba-column-2": {
          "type": "column",
          "settings": {
            "title": "Restores movement your eyes normally don’t get",
            "text": "<p>Instead of staring in one direction all day, the device engages horizontal, vertical, diagonal and rotational motions that counteract static near-work posture. This helps maintain balance in your extraocular muscles.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "template--21538193178908__3713e29a-195e-4401-921e-9f6dd0dcc6ba-column-3": {
          "type": "column",
          "settings": {
            "title": "Works off-screen, in real space",
            "text": "<p>The training happens on a wall or ceiling, not on a phone or monitor.<br/>This avoids adding even more screen time while trying to relax your eyes — a known limitation of app-based exercises.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "template--21538193178908__3713e29a-195e-4401-921e-9f6dd0dcc6ba-column-1",
