    "9af997f2-18cc-4662-b276-5b073cd32edd": {
      "type": "collapsible-content",
      "blocks": {
        "template--21538193178908__9af997f2-18cc-4662-b276-5b073cd32edd-collapsible_row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is this a medical device that will fix my eyesight?",
            "icon": "question_mark",
            "row_content": "<p><strong>No.</strong> Eye Star Vision is a training and relaxation tool for eye movement.<br/><strong>It does not diagnose conditions, treat medical issues, or replace glasses.</strong></p>",
            "page": ""
          }
        },
        "template--21538193178908__9af997f2-18cc-4662-b276-5b073cd32edd-collapsible_row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need to do special exercises or memorize routines?",
            "icon": "question_mark",
            "row_content": "<p><strong>No. </strong>The device leads the movement visually so you only follow the dot with your eyes.<br/>There’s no counting, no apps, and no learning curve.</p>",
            "page": ""
          }
        },
        "template--21538193178908__9af997f2-18cc-4662-b276-5b073cd32edd-collapsible_row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is the device safe for my eyes?",
            "icon": "question_mark",
            "row_content": "<p><strong>Yes.</strong> The laser dot is not looked into directly — it is projected on a wall or ceiling and simply followed with your eyes.<br/>You should <strong>never point the device toward eyes</strong>, reflective surfaces, or mirrors.</p>",
            "page": ""
          }
        },
        "b8ee14b2-a7c5-437e-8f0c-2453da288c00": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where should I use the device?",
            "icon": "question_mark",
            "row_content": "<p>Place it at eye level and project onto a matte, light-colored surface such as a wall or ceiling.<br/><strong>Avoid </strong>reflective or glossy surfaces that could bounce the beam.</p>",
            "page": ""
          }
        },
        "9482ea3a-54f1-4d44-a5d6-be68ba27166a": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long should I use it per day?",
            "icon": "question_mark",
            "row_content": "<p>Short, consistent sessions are most effective. Most users will benefit from <strong>5–6 minutes</strong> of guided movement daily.</p>",
            "page": ""
          }
        },
        "template--21538193178908__9af997f2-18cc-4662-b276-5b073cd32edd-collapsible_row-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need to have vision problems to use it?",
            "icon": "question_mark",
            "row_content": "<p><strong>No</strong>. Eye Star Vision is designed for everyday users — anyone who spends time on screens, studies, works remotely, games, or simply wants to relax their eyes.<br/>You don’t need <strong>prior training or special experience</strong> to benefit from it.</p>",
            "page": ""
          }
        }
      },
